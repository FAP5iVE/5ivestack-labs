# Consultation form (milestone M4). Copy to .env.local for local testing.
# On Vercel set the same names under Project Settings > Environment Variables, then REDEPLOY
# (the home page is built statically, so changes take effect on the next build).
# The form is live only when CONSULT_ENABLED=true AND RESEND_API_KEY is set AND the privacy
# notice is marked reviewed in src/content/privacy.ts. Never commit real values.

CONSULT_ENABLED=true
RESEND_API_KEY=re_paste_your_key_here_in_vercel_or_env_local_only
# Where requests are delivered:
CONSULT_TO=fivestacklabs@gmail.com
# Sender. The Resend test sender below can only deliver to the email address the Resend account
# was created with. To send to anyone else, verify a domain in Resend and use an address on it.
CONSULT_FROM=5iveStack Labs <onboarding@resend.dev>

# Search engines. Keep false until launch. When true (at build time) pages become indexable,
# robots.txt allows crawling and the sitemap is filled. Redeploy after changing it.
SITE_INDEXABLE=false

# Content-Security-Policy (decision D-57). Leave unset in production. Set to true only to switch the
# policy to report-only (the browser logs violations but blocks nothing) if a page ever breaks.
# CSP_REPORT_ONLY=true
